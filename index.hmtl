  <script>
    function switchTab(tabId) {
      // Hide all tabs
      const contents = document.querySelectorAll('.tab-content');
      contents.forEach(content => {
        content.classList.remove('active');
      });

      // Show selected tab
      const selectedTab = document.getElementById(tabId);
      if (selectedTab) {
        selectedTab.classList.add('active');
      }

      // Update button styling
      const btnMain = document.getElementById('btn-tab-main');
      const btnChess = document.getElementById('btn-tab-chess');

      if (tabId === 'tab-main') {
        btnMain.className = 'tab-btn px-3 sm:px-4 py-2 rounded-lg transition-all duration-200 flex items-center gap-2 bg-white dark:bg-slate-700 text-emerald-600 dark:text-emerald-400 shadow-sm';
        btnChess.className = 'tab-btn px-3 sm:px-4 py-2 rounded-lg transition-all duration-200 flex items-center gap-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white';
      } else {
        btnChess.className = 'tab-btn px-3 sm:px-4 py-2 rounded-lg transition-all duration-200 flex items-center gap-2 bg-white dark:bg-slate-700 text-amber-600 dark:text-amber-400 shadow-sm';
        btnMain.className = 'tab-btn px-3 sm:px-4 py-2 rounded-lg transition-all duration-200 flex items-center gap-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white';
      }

      // Scroll to top smoothly
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function filterVocab() {
      const input = document.getElementById('vocab-search').value.toLowerCase();
      const cards = document.querySelectorAll('.vocab-card');

      cards.forEach(card => {
        const text = card.innerText.toLowerCase();
        if (text.includes(input)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function toggleDarkMode() {
      const htmlEl = document.documentElement;
      const darkIcon = document.getElementById('theme-toggle-dark-icon');
      const lightIcon = document.getElementById('theme-toggle-light-icon');

      if (htmlEl.classList.contains('dark')) {
        htmlEl.classList.remove('dark');
        darkIcon.classList.add('hidden');
        lightIcon.classList.remove('hidden');
        localStorage.setItem('theme', 'light');
      } else {
        htmlEl.classList.add('dark');
        darkIcon.classList.remove('hidden');
        lightIcon.classList.add('hidden');
        localStorage.setItem('theme', 'dark');
      }
    }

    // Set default dark mode or load saved theme
    (function initTheme() {
      const savedTheme = localStorage.getItem('theme');
      const darkIcon = document.getElementById('theme-toggle-dark-icon');
      const lightIcon = document.getElementById('theme-toggle-light-icon');

      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
        if (darkIcon && lightIcon) {
          darkIcon.classList.remove('hidden');
          lightIcon.classList.add('hidden');
        }
      } else {
        document.documentElement.classList.remove('dark');
        if (darkIcon && lightIcon) {
          darkIcon.classList.add('hidden');
          lightIcon.classList.remove('hidden');
        }
      }
    })();
  </script>
